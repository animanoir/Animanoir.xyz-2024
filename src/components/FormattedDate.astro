---
interface Props {
  date: Date;
}

const { date } = Astro.props;
---

<style>
  /* Dates are data: mono, tabular, muted (phase 3). */
  time {
    font-family: var(--font-mono);
    font-size: var(--type-meta);
    color: var(--color-ink);
    opacity: 0.6;
  }
</style>

<!-- Site-wide date format: ISO-like YYYY-MM-DD. -->
<time datetime={date.toISOString()}>
  {date.toISOString().slice(0, 10)}
</time>
