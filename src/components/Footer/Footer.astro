---
// Colophon footer (phase 6): a left-anchored closing block in the mono/meta
// register — index, elsewhere, colophon — not a utility bar. Sits in the
// content flow; the phase 5 frame provides the page's actual bottom edge, so
// there is no closing hairline here.
import { buildVersion } from "@/lib/buildMeta";

const year = new Date().getFullYear();
const version = buildVersion();

const nav = [
  { href: "/work", label: "Work" },
  { href: "/#about", label: "About" },
  { href: "/blog", label: "Writing" },
  { href: "mailto:etherealflux94@gmail.com", label: "Contact" },
];

const elsewhere = [
  { href: "https://github.com/animanoir", label: "GitHub" },
  { href: "https://www.linkedin.com/in/oscaramontiel/", label: "LinkedIn" },
  {
    href: "https://www.youtube.com/channel/UCGe1qc0nF0uNypETYDQmMMQ",
    label: "YouTube",
  },
  {
    href: "https://www.are.na/tilde-colon-pipe-degrees-degrees-bullet-period-pipe-colon-tilde/channels",
    label: "Are.na",
  },
  { href: "https://steamcommunity.com/id/geosmina/", label: "Steam" },
];
---

<footer>
  <div class="colophon">
    <div class="colophon-inner">
      <div class="cols">
        <nav aria-label="Footer navigation">
          <h2 class="label">Index</h2>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>

        <section>
          <h2 class="label">Everywhere</h2>
          <ul>
            {
              elsewhere.map((item) => (
                <li>
                  <a
                    class="link-external"
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <p>{year} Óscar A. Montiel · Querétaro, MX</p>
          <p class="version">v.{version}</p>
        </section>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--space-section);
    /* Keep the last line clear of the fixed frame's bottom hairline. */
    padding-bottom: calc(var(--frame-inset) + 2rem);
    font-family: var(--font-mono);
    font-size: var(--type-meta);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  /* Same left anchor and max measure as every content page. */
  .colophon {
    margin-left: var(--left-rail);
    margin-right: var(--page-padding, 5%);
  }

  .colophon-inner {
    max-width: 68rem;
    margin: 0 auto;
    border-top: 0.5px solid rgba(var(--color-ink-rgb), 0.15);
    padding-top: 2rem;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    max-width: var(--measure-wide);
  }

  .label {
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--type-meta);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    margin: 0 0 0.5rem;
  }

  p {
    margin: 0 0 0.5rem;
    padding: 0;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Same link treatment as post body links (phase 4). */
  a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 0.2s ease;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-ink);
  }

  a:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 4px;
  }

  .link-external::after {
    content: " ↗";
    font-size: 0.8em;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .colophon {
      margin-left: 0;
      padding: 0 1.5rem;
    }

    .cols {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
