---
// Structural framing (phase 5): a fixed hairline frame with corner marks and
// one line of ambient corner data (current date). Rendered once per page via
// ModifiedHeader. Purely visual: pointer-events none, aria-hidden. The build
// version lives in the footer colophon.

// Server-rendered fallback; the script below replaces it with the viewer's
// local date, so a long-lived static build never shows a stale day.
const buildDate = new Date().toISOString().slice(0, 10);
---

<div class="page-frame" aria-hidden="true">
  <span class="corner corner-tl"></span>
  <span class="corner corner-tr"></span>
  <span class="corner corner-bl"></span>
  <span class="corner corner-br"></span>
  <span class="corner-data data-br">{buildDate}</span>
</div>

<script>
  // Current date for the bottom-right corner datum, in the viewer's local
  // time and the site-wide ISO format. Re-applied after ClientRouter swaps.
  function setCornerDate() {
    const el = document.querySelector(".page-frame .data-br");
    if (!el) return;
    const d = new Date();
    const pad2 = (n: number) => String(n).padStart(2, "0");
    el.textContent = `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
  }

  setCornerDate();
  document.addEventListener("astro:page-load", setCornerDate);
</script>

<style>
  .page-frame {
    position: fixed;
    inset: var(--frame-inset);
    /* 0.5px border over inset box-shadow: the codebase's existing hairlines
       are 0.5px borders and render consistently here; a 0.5px inset shadow
       anti-aliases to nothing on non-retina displays. */
    border: 0.5px solid rgba(var(--color-ink-rgb), var(--frame-opacity));
    pointer-events: none;
    /* Above page content, below the interactive chrome (navbar 1000+). */
    z-index: 900;
  }

  /* Corner marks: two short perpendicular strokes forming an L, sitting on
     the frame line at a slightly higher opacity — they reinforce the corners
     the way registration marks do on a technical drawing. */
  .corner {
    position: absolute;
    width: 16px;
    height: 16px;
  }

  .corner::before,
  .corner::after {
    content: "";
    position: absolute;
    background: rgba(var(--color-ink-rgb), var(--frame-mark-opacity));
  }

  /* Horizontal arm. */
  .corner::before {
    width: 16px;
    height: 0.5px;
  }

  /* Vertical arm. */
  .corner::after {
    width: 0.5px;
    height: 16px;
  }

  .corner-tl { top: -0.5px; left: -0.5px; }
  .corner-tr { top: -0.5px; right: -0.5px; }
  .corner-bl { bottom: -0.5px; left: -0.5px; }
  .corner-br { bottom: -0.5px; right: -0.5px; }

  .corner-tl::before, .corner-tl::after { top: 0; left: 0; }
  .corner-tr::before { top: 0; right: 0; }
  .corner-tr::after { top: 0; right: 0; }
  .corner-bl::before { bottom: 0; left: 0; }
  .corner-bl::after { bottom: 0; left: 0; }
  .corner-br::before { bottom: 0; right: 0; }
  .corner-br::after { bottom: 0; right: 0; }

  /* Ambient corner datum: mono, uppercase, tabular — a real value only. */
  .corner-data {
    position: absolute;
    bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--type-meta);
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(var(--color-ink-rgb), var(--frame-mark-opacity));
    white-space: nowrap;
  }

  .data-br { right: 0.75rem; }

  /* Mobile keeps the frame but drops the data — crowding beats absence. */
  @media (max-width: 768px) {
    .corner-data {
      display: none;
    }
  }

  @media print {
    .page-frame {
      display: none;
    }
  }
</style>
