---
import BaseHead from "../components/BaseHead.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";

import "../styles/global.css";
import ModifiedHeader from "@/components/ModifiedHeader.astro";
import Footer from "@/components/Footer/Footer.astro";
import SignatureLayer from "@/components/SignatureLayer/SignatureLayer.astro";
import FlowShader from "@/components/FlowShader/FlowShader.astro";

// Narrative homepage (phase 2): a 5-movement scroll.
// 1 thesis → 2–4 three featured works → 5 close (bio, email, full index).
// Plain CSS scroll — no scroll-jacking; reveals honor prefers-reduced-motion.

const TYPE_TO_MEDIUM = {
  Games: "game",
  Installations: "installation",
  "Sound & Music": "sound",
  "Web & Code": "web",
};

// Featured works are chosen by the `featuredOrder` frontmatter flag (ascending).
// Swap the homepage selection by moving that flag between works.
const featured = (await getCollection("works"))
  .filter((w) => typeof w.data.featuredOrder === "number")
  .sort((a, b) => (a.data.featuredOrder ?? 0) - (b.data.featuredOrder ?? 0))
  .slice(0, 3);

const features = await Promise.all(
  featured.map(async (w) => {
    const img = w.data.heroImage
      ? await getImage({
          src: w.data.heroImage,
          format: "webp",
          widths: [600, 900, 1400],
          quality: 85,
        })
      : null;
    return {
      href: `/works/${w.id}/`,
      title: w.data.title,
      description: w.data.description,
      year: String(w.data.year ?? w.data.pubDate.getFullYear()),
      medium:
        w.data.medium ??
        (w.data.workType || []).map((t) => TYPE_TO_MEDIUM[t] ?? t).join(" · "),
      img,
    };
  }),
);
---

<html lang="en">
  <head>
    <BaseHead
      title="Creative Software Developer & Interactive Media Artist"
      description={"Óscar A. Montiel — creative developer & interactive media artist building interactive 3D for the web (Three.js / WebGL), installations, generative sound, games, and videoart."}
    />
  </head>
  <body>
    <ModifiedHeader animated />

    <main>
      <!-- 1 · Thesis — full viewport, over the generative signature layer.
           Carries the #about anchor: the bio + contact block sits directly
           under the quote. -->
      <section class="thesis" id="about">
        <div class="signature-slot" aria-hidden="true">
          <SignatureLayer />
        </div>
        <div class="thesis-content">
          <h1 class="thesis-text">
            <span class="thesis-line">Play as method.</span>
            <span class="thesis-line thesis-sub"
              >Interactive 3D, generative sound &amp; games&nbsp;&nbsp;∿</span
            >
          </h1>
          <p class="thesis-bio">
            <b>Creative Software Developer</b> &amp; <b
              >Interactive Media Artist</b
            >.
            <br />
            <br />
            I build interactive 3D for the web, generative systems, installations,
            and video games—from concept through production code.
            <br />
            <br />
            <strong
              >Available for studio roles, freelance, and commissions.</strong
            >
          </p>
          <p class="thesis-links">
            <a href="mailto:etherealflux94@gmail.com"
              >etherealflux94@gmail.com</a
            >
            <span class="thesis-sep" aria-hidden="true">·</span>
            <a href="/work">full index of works</a>
            <span class="thesis-sep" aria-hidden="true">·</span>
            <!-- TODO: drop cv-oscar-a-montiel.pdf into public/ -->
            <a href="/cv-oscar-a-montiel.pdf" target="_blank" rel="noopener"
              >CV (PDF)</a
            >
          </p>
        </div>
      </section>

      <!-- 1b · Flow — full-bleed Three.js shader band: an ethereal current of
           blue/purple/red surging out of a far horizon toward the viewer. -->
      <section class="flow" aria-hidden="true">
        <FlowShader />
      </section>

      <!-- 2–4 · Three featured works, one per viewport, media alternating. -->
      {
        features.map((f, i) => (
          <section class:list={["feature", "reveal", { flipped: i % 2 === 1 }]}>
            <a
              class="feature-media"
              href={f.href}
              tabindex="-1"
              aria-hidden="true"
            >
              {f.img && (
                <img
                  src={f.img.src}
                  srcset={f.img.srcSet?.attribute ?? undefined}
                  sizes="(max-width: 768px) 100vw, 55vw"
                  alt=""
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              )}
            </a>
            <div class="feature-text">
              <p class="mono-label">
                {f.year} · {f.medium}
              </p>
              <h2 class="feature-title">
                <a href={f.href}>{f.title}</a>
              </h2>
              <p class="feature-desc">{f.description}</p>
            </div>
          </section>
        ))
      }
    </main>
    <Footer />

    <style>
      main {
        margin-left: var(--left-rail);
        margin-right: var(--page-padding, 5%);
        /* Featured sections stay a composed width on large desktops; the
           full-bleed bands (signature, flow) escape via negative margins. */
        max-width: var(--content-max);
      }

      .mono-label {
        font-family: var(--font-mono);
        font-size: var(--type-meta);
        letter-spacing: 0.06em;
        color: var(--color-ink);
        opacity: 0.55;
        margin: 0;
        padding: 0;
      }

      /* -- 1 · Thesis ------------------------------------------------------ */
      .thesis {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: calc(var(--space-section) * 0.5) 0;
        box-sizing: border-box;
      }

      /* Full-bleed: cancel main's left-rail offset so the particle field
         spans the entire viewport width, not just the content column. */
      .signature-slot {
        position: absolute;
        top: 0;
        bottom: 0;
        left: calc(-1 * var(--left-rail));
        width: 100vw;
        pointer-events: none;
      }

      .thesis-content {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* The ONE italic on the entire site (phase 3 italic policy):
         the thesis quote, Plex Sans 400 italic. */
      .thesis-text {
        margin: 0;
        max-width: 22ch;
        font-family: var(--font-sans);
        font-style: italic;
        font-weight: 400;
        font-size: var(--type-display);
        letter-spacing: -0.01em;
        line-height: 1.12;
        color: var(--color-ink);
        animation: riseIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
      }

      .thesis-line {
        display: block;
      }

      .thesis-sub {
        font-family: var(--font-mono);
        font-style: normal;
        font-size: var(--type-meta);
        letter-spacing: 0.12em;
        line-height: 1.4;
        opacity: 0.6;
        margin-top: 1.6rem;
        text-transform: lowercase;
      }

      @keyframes riseIn {
        from {
          opacity: 0;
          transform: translateY(2rem);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* -- 1b · Flow band ---------------------------------------------------
         Full-bleed: cancel main's left-rail/right margins so the current spans
         the whole viewport width. */
      .flow {
        position: relative;
        /* Tall enough that the serpent's glow dissolves into black before the
           container edge — the rectangle never reads. */
        height: 95vh;
        /* Full-bleed via 100vw (same as .signature-slot) — a negative
           percentage margin-right resolves against main's width, not the
           viewport, and left a gap at the right edge. */
        margin-left: calc(-1 * var(--left-rail));
        width: 100vw;
      }

      /* Bio + contact directly under the quote, staggered into view after it. */
      .thesis-bio {
        max-width: 52ch;
        margin: 3rem 0 0;
        padding: 0;
        font-family: var(--font-sans);
        font-size: var(--type-body);
        line-height: 1.6;
        color: var(--color-ink);
        opacity: 0.92;
        animation: riseIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
      }

      .thesis-links {
        margin: 1.75rem 0 0;
        padding: 0;
        font-family: var(--font-mono);
        font-size: var(--type-meta);
        letter-spacing: 0.04em;
        animation: riseIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
      }

      .thesis-links a {
        color: var(--color-ink);
        text-decoration: underline;
        text-decoration-color: rgba(var(--color-ink-rgb), 0.35);
        text-underline-offset: 0.25em;
        transition: color 0.2s ease;
      }

      .thesis-links a:hover,
      .thesis-links a:focus-visible {
        color: var(--color-accent);
      }

      .thesis-sep {
        margin: 0 0.75rem;
        opacity: 0.4;
      }

      @media (prefers-reduced-motion: reduce) {
        .thesis-text,
        .thesis-bio,
        .thesis-links {
          animation: none;
        }
      }

      /* -- 2–4 · Featured works --------------------------------------------- */
      .feature {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 55% 1fr;
        gap: 3rem;
        align-items: center;
        padding: var(--space-section) 0;
        box-sizing: border-box;
      }

      .feature.flipped .feature-media {
        order: 2;
      }

      .feature-media {
        display: block;
        /* Fixed ratio so lazy media never shifts layout. */
        aspect-ratio: 16 / 10;
        overflow: hidden;
      }

      .feature-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.2, 0, 0.2, 1);
      }

      .feature:hover .feature-media img {
        transform: scale(1.03);
      }

      .feature-title {
        margin: 0.75rem 0 0;
        font-family: var(--font-sans);
        font-weight: var(--weight-heading);
        font-size: calc(var(--type-display) * 0.62);
        letter-spacing: -0.01em;
        line-height: 1.08;
      }

      .feature-title a {
        color: var(--color-ink);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .feature-title a:hover,
      .feature-title a:focus-visible {
        color: var(--color-accent);
      }

      .feature-title a:focus-visible {
        outline: 1px solid var(--color-accent);
        outline-offset: 4px;
      }

      .feature-desc {
        max-width: 38ch;
        margin: 1.25rem 0 0;
        padding: 0;
        font-family: var(--font-sans);
        font-size: var(--type-body);
        line-height: 1.55;
        color: var(--color-ink);
        opacity: 0.85;
      }

      /* -- Reveal on enter --------------------------------------------------
         Featured works fade in when scrolled into view. Only applied when
         motion is allowed; reduced-motion shows content as-is. */
      @media (prefers-reduced-motion: no-preference) {
        .reveal {
          opacity: 0;
          transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal.is-visible {
          opacity: 1;
        }
      }

      /* -- Responsive -------------------------------------------------------- */
      @media (max-width: 768px) {
        main {
          margin-left: 0;
          padding: 0 1.5rem;
        }

        .thesis {
          min-height: 92vh;
        }

        /* Full-bleed against the mobile 1.5rem gutters. */
        .flow {
          height: 70vh;
          margin-left: -1.5rem;
          width: 100vw;
        }

        .signature-slot {
          left: -1.5rem;
        }

        .feature {
          grid-template-columns: 1fr;
          gap: 1.5rem;
          min-height: 0;
          padding: calc(var(--space-section) * 0.6) 0;
        }

        .feature.flipped .feature-media {
          order: 0;
        }
      }
    </style>

    <script>
      // Reveal-on-enter for the featured/close sections. Skipped entirely for
      // reduced-motion users (the CSS never hides content for them). Re-runs
      // after Astro page transitions.
      function initReveals() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
          return;

        const targets = document.querySelectorAll(".reveal:not(.is-visible)");
        if (targets.length === 0) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2 },
        );

        targets.forEach((el) => observer.observe(el));
      }

      // Astro module scripts run after the DOM is parsed, so init directly —
      // waiting only on astro:page-load can miss the first paint and leave
      // the sections stuck invisible. Re-init after ClientRouter swaps.
      initReveals();
      document.addEventListener("astro:page-load", initReveals);
    </script>
  </body>
</html>
