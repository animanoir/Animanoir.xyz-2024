---
import BaseHead from "../../components/BaseHead.astro";
import ModifiedHeader from "../../components/ModifiedHeader.astro";
import { getAllPosts } from "../../lib/sanity";
import Footer from "../../components/Footer/Footer.astro";

// Writing index (phase 3): the same typographic list language as the Work
// index — hairline-separated rows of date · title, grouped by year under a
// small mono label. No covers, no excerpts: the list IS the design. Row
// styles come from the shared .index-row classes in global.css.

const posts = await getAllPosts();

const rows = posts.map((post) => ({
  href: `/blog/${post.slug.current}/`,
  // Site-wide date format: ISO-like YYYY-MM-DD.
  date: post.publishedAt.slice(0, 10),
  year: new Date(post.publishedAt).getFullYear(),
  title: post.title,
}));

// Group by year, newest first (getAllPosts already returns publishedAt desc).
const years = [...new Set(rows.map((r) => r.year))].sort((a, b) => b - a);
---

<html lang="en">
  <head>
    <BaseHead
      title="Writing"
      description={"Blog & studies about subjects I find interesting and fun. Expect random, weird and probably confusing thoughts."}
    />
  </head>
  <body>
    <ModifiedHeader />
    <h1 class="visually-hidden">Writing - Óscar A. Montiel</h1>
    <main>
      {
        years.map((year) => (
          <section class="year-section">
            <h2 class="index-group-label">{year}</h2>
            <ul class="index-list">
              {rows
                .filter((r) => r.year === year)
                .map((r) => (
                  <li>
                    <a class="index-row" data-astro-prefetch href={r.href}>
                      <time class="index-row-meta" datetime={r.date}>
                        {r.date}
                      </time>
                      <span class="index-row-title">{r.title}</span>
                    </a>
                  </li>
                ))}
            </ul>
          </section>
        ))
      }
    </main>
    <Footer />
    <style>
      main {
        /* Same geometry as the Work index page (/work). */
        margin-left: var(--left-rail);
        margin-right: var(--page-padding, 5%);
        max-width: var(--content-max);
        padding-top: 22vh;
        padding-bottom: var(--space-section);
        min-height: 70vh;
        /* Full ISO dates in the first row column. */
        --index-col: 10ch;
      }

      .year-section:first-child .index-group-label {
        margin-top: 0;
      }

      @media (max-width: 768px) {
        main {
          margin-left: 0;
          padding: 30% 1.5rem var(--space-section);
        }
      }
    </style>
  </body>
</html>
