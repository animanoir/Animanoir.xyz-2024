---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import ModifiedHeader from "../components/ModifiedHeader.astro";
import { Picture } from "astro:assets";
import Footer from "@/components/Footer/Footer.astro";

// Editorial case study template (phase 2). Fixed sequence:
// hero → intent → body (process/evidence) → process media → technical note →
// metadata footer → sequential navigation. Optional sections render nothing
// when their frontmatter field is absent.

interface WorkLink {
  href: string;
  title: string;
}

interface Props {
  post: CollectionEntry<"works">;
  prev?: WorkLink;
  next?: WorkLink;
}

const { post, prev, next } = Astro.props;
const {
  title,
  description,
  heroImage,
  intent,
  processMedia,
  technicalDetail,
  stack,
  tools,
  role,
  year,
  pubDate,
} = post.data;

const displayYear = year ?? pubDate.getFullYear();
// The metadata footer's stack falls back to the legacy `tools` field.
const stackList = stack ?? tools ?? [];
const metaLine = [String(displayYear), stackList.join(" / "), role]
  .filter(Boolean)
  .join(" · ");
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage?.src}
      type="article"
      author="Óscar A. Montiel"
    />
  </head>
  <body>
    <ModifiedHeader />
    <main>
      <div class="case">
        <!-- 1 · Hero: one large media + the title. Nothing else above the fold. -->
        <section class="hero">
          {
            heroImage && (
              <Picture
                src={heroImage}
                alt={description}
                class="heroImage"
                formats={["webp"]}
                widths={[600, 900, 1500]}
                sizes="(max-width: 768px) 100vw, 745px"
                decoding="async"
                loading="eager"
                quality={80}
              />
            )
          }
          <h1 class="title">{title}</h1>
        </section>

        <!-- 2 · Intent: a single prose paragraph, 65ch. Renders nothing when
             the frontmatter field is missing (build logs which works lack it). -->
        {
          intent && (
            <section class="intent">
              <p>{intent}</p>
            </section>
          )
        }

        <!-- 3 · Process / evidence: the work's MDX body. -->
        <article class="articleBody">
          <slot />
        </article>

        <!-- 3b · Optional additional process media, two-up. -->
        {
          processMedia && processMedia.length > 0 && (
            <section class="process-media">
              {processMedia.map((media) => (
                <Picture
                  src={media}
                  alt={title}
                  formats={["webp"]}
                  decoding="async"
                  loading="lazy"
                  quality={80}
                />
              ))}
            </section>
          )
        }

        <!-- 4 · Technical detail, under a small mono label. -->
        {
          technicalDetail && (
            <section class="technical">
              <span class="mono-label">technical note</span>
              <p>{technicalDetail}</p>
            </section>
          )
        }

        <!-- 5 · Metadata footer: hairline rule, one mono line. -->
        <footer class="meta-footer">
          <p class="mono-label">{metaLine}</p>
        </footer>

        <!-- 6 · Sequential navigation — no dead ends. -->
        <nav class="sequence" aria-label="Work navigation">
          {
            prev && (
              <a class="seq-link seq-prev" href={prev.href}>
                <span class="mono-label">previous</span>
                <span class="seq-title">{prev.title}</span>
              </a>
            )
          }
          {
            next && (
              <a class="seq-link seq-next" href={next.href}>
                <span class="mono-label">next work</span>
                <span class="seq-title">{next.title}</span>
              </a>
            )
          }
        </nav>
      </div>
    </main>
    <Footer />
    <style>
      body {
        margin: 0;
        overflow-x: hidden;
      }

      main {
        margin-left: var(--left-rail);
        margin-right: var(--page-padding, 5%);
      }

      .case {
        max-width: var(--content-max);
        margin: 0 auto;
        padding-bottom: var(--space-section);
      }

      /* -- 1 · Hero ------------------------------------------------------- */
      .hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-top: 14vh;
        box-sizing: border-box;
      }

      /* The hero is a figure, not a banner: capped at the wide measure (the
         same width the post grid gives figures) and the 16:10 box the work
         index preview uses, so it reads as one system. */
      .hero :global(.heroImage) {
        width: 100%;
        max-width: var(--measure-wide);
        aspect-ratio: 16 / 10;
        max-height: 52vh;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.5s ease-in-out;
      }

      .hero :global(.heroImage.loaded) {
        opacity: 1;
      }

      .title {
        margin: 2rem 0 0;
        font-family: var(--font-sans);
        font-weight: var(--weight-heading);
        font-size: var(--type-display);
        letter-spacing: -0.01em;
        line-height: 1.05;
        color: var(--color-ink);
      }

      /* -- 2 · Intent ------------------------------------------------------ */
      .intent {
        margin-top: var(--space-section);
      }

      .intent p {
        max-width: var(--measure);
        margin: 0;
        padding: 0;
        font-family: var(--font-sans);
        font-size: calc(var(--type-body) * 1.25);
        font-weight: var(--weight-heading);
        line-height: 1.55;
        color: var(--color-ink);
      }

      /* -- 3 · Body -------------------------------------------------------- */
      .articleBody {
        margin-top: var(--space-section);
        max-width: var(--measure);
        font-family: var(--font-sans);
        font-weight: 400;
        color: var(--color-ink);
        font-size: var(--type-body);
        line-height: 1.6;
      }

      .articleBody :global(p) {
        padding: 0 !important;
        margin: 1.8rem 0 2.4rem !important;
      }

      .articleBody :global(h2),
      .articleBody :global(h3),
      .articleBody :global(h4) {
        margin-top: 4.2rem !important;
        margin-bottom: 1.8rem !important;
        font-family: var(--font-sans);
        font-weight: var(--weight-heading);
      }

      .articleBody :global(img),
      .articleBody :global(video),
      .articleBody :global(lite-youtube) {
        margin: 3.6rem 0 !important;
        max-width: 100%;
        height: auto;
      }

      /* -- 3b · Process media ---------------------------------------------- */
      .process-media {
        margin-top: var(--space-section);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .process-media :global(img) {
        width: 100%;
        height: auto;
        display: block;
      }

      /* -- 4 · Technical note ---------------------------------------------- */
      .technical {
        margin-top: var(--space-section);
      }

      .technical p {
        max-width: var(--measure);
        margin: 1rem 0 0;
        padding: 0;
        font-family: var(--font-sans);
        font-size: var(--type-body);
        line-height: 1.6;
      }

      /* Shared small mono label. */
      .mono-label {
        font-family: var(--font-mono);
        font-size: var(--type-meta);
        letter-spacing: 0.06em;
        color: var(--color-ink);
        opacity: 0.55;
      }

      /* -- 5 · Metadata footer --------------------------------------------- */
      .meta-footer {
        margin-top: var(--space-section);
        border-top: 0.5px solid rgba(var(--color-ink-rgb), 0.35);
        padding-top: 1.25rem;
      }

      .meta-footer p {
        margin: 0;
        padding: 0;
      }

      /* -- 6 · Sequential navigation ---------------------------------------- */
      .sequence {
        margin-top: var(--space-section);
        display: flex;
        justify-content: space-between;
        gap: 2rem;
      }

      .seq-link {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        text-decoration: none;
        color: var(--color-ink);
      }

      .seq-next {
        margin-left: auto;
        text-align: right;
      }

      .seq-title {
        font-family: var(--font-sans);
        font-weight: var(--weight-heading);
        font-size: var(--type-body);
        transition: color 0.2s ease;
      }

      .seq-link:hover .seq-title,
      .seq-link:focus-visible .seq-title {
        color: var(--color-accent);
      }

      .seq-link:focus-visible {
        outline: 1px solid var(--color-accent);
        outline-offset: 4px;
      }

      /* -- Responsive ------------------------------------------------------- */
      @media (max-width: 768px) {
        main {
          margin-left: 0;
          padding: 0 1.5rem;
        }

        .hero {
          min-height: 0;
          padding-top: 34%;
        }

        .hero :global(.heroImage) {
          max-height: 46vh;
        }

        .process-media {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
