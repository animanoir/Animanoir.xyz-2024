---
import BaseHead from "../components/BaseHead.astro";
import ModifiedHeader from "../components/ModifiedHeader.astro";
import Footer from "@/components/Footer/Footer.astro";

// Technical-journal post template (phase 4). One grid, three widths:
// every child of the article opts into text (65ch), wide (~1.35×), or full.
// Sequence: header (eyebrow → balanced title → deck → labeled metadata) →
// hero figure with text-anchored caption → body → footer (tags, prev/next).

interface PostLink {
  href: string;
  title: string;
}

interface MetaPair {
  label: string;
  value: string;
}

interface Props {
  title: string;
  summary?: string;
  deck?: string;
  pubDate: Date;
  hero?: { src: string; alt?: string };
  heroCaption?: string;
  heroCredit?: string;
  heroWidth?: "text" | "wide" | "full";
  tags?: string[];
  slug?: string;
  meta?: MetaPair[];
  prev?: PostLink;
  next?: PostLink;
}

const {
  title,
  summary,
  deck,
  pubDate,
  hero,
  heroCaption,
  heroCredit,
  heroWidth = "wide",
  tags,
  meta = [],
  prev,
  next,
} = Astro.props;

// Site-wide date format: ISO-like YYYY-MM-DD.
const isoDate = pubDate.toISOString().slice(0, 10);

// Null-safe (Sanity nulls bypass destructuring defaults): heroes default wide.
const heroCol = heroWidth ?? "wide";

// Eyebrow: the post's first tag, else the section name.
const eyebrow = tags?.[0] ?? "writing";

// Labeled metadata pairs; posts append their own via the `meta` field.
// (Sanity returns null — not undefined — for absent fields, so coalesce.)
const metaPairs: MetaPair[] = [
  { label: "date", value: isoDate },
  ...(meta ?? []),
];

// Hero images are served pre-cropped to 4:3 (the native ratio of 6 of the 7
// existing heroes) — see [...slug].astro. 1600×1200 rendered box.
const HERO_W = 1600;
const HERO_H = 1200;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={summary ??
        "Blog post by Óscar A. Montiel: interactive media artist."}
      image={hero?.src}
      type="article"
      publishDate={pubDate?.toISOString()}
      author="Óscar A. Montiel"
    />
  </head>
  <body>
    <ModifiedHeader />
    <main>
      <article class="post">
        <!-- 1 · Header block: eyebrow, balanced title, optional deck, labeled
             metadata as a definition list, hairline rule. -->
        <header class="post-header">
          <p class="eyebrow">{eyebrow}</p>
          <h1 class="title">{title}</h1>
          {deck && <p class="deck">{deck}</p>}
          <dl class="meta-row">
            {
              metaPairs.map((pair) => (
                <div class="meta-pair">
                  <dt>{pair.label}</dt>
                  <dd>
                    {pair.label === "date" ? (
                      <time datetime={pubDate.toISOString()}>{pair.value}</time>
                    ) : (
                      pair.value
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>
        </header>

        <!-- 2 · Hero as a figure on the grid (default wide), fixed 4:3 box,
             caption anchored to the text column's left edge. Deliberately
             OUTSIDE the body zone: the gutter rules bound the reading column
             only — a wide hero crossing them read as overflow. -->
        {
          hero && (
            <figure class="post-hero" data-width={heroCol}>
              <img
                src={hero.src}
                alt={hero.alt ?? title}
                width={HERO_W}
                height={HERO_H}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              {(heroCaption || heroCredit) && (
                <figcaption>
                  {heroCaption}
                  {heroCaption && heroCredit && (
                    <span class="credit-sep" aria-hidden="true">
                      {" "}
                      ·{" "}
                    </span>
                  )}
                  {heroCredit}
                </figcaption>
              )}
            </figure>
          )
        }

        <!-- 3 · Body. The renderer's wrapper is display:contents so every
             block sits directly on the article grid. -->
        <slot />

        <!-- 4 · Footer: hairline, tags, sequential navigation, back link. -->
        <footer class="post-footer">
          {
            tags && tags.length > 0 && (
              <p class="tag-row">{tags.join(" · ")}</p>
            )
          }
          <nav class="sequence" aria-label="Post navigation">
            {
              prev && (
                <a class="seq-link seq-prev" href={prev.href}>
                  <span class="mono-label">previous</span>
                  <span class="seq-title">{prev.title}</span>
                </a>
              )
            }
            {
              next && (
                <a class="seq-link seq-next" href={next.href}>
                  <span class="mono-label">next post</span>
                  <span class="seq-title">{next.title}</span>
                </a>
              )
            }
          </nav>
          <a class="back-link mono-label" href="/blog">← index</a>
        </footer>
      </article>
    </main>
    <Footer />
    <style>
      main {
        /* Same geometry as the Work pages. */
        margin-left: var(--left-rail);
        margin-right: var(--page-padding, 5%);
      }

      /* == The article grid (phase 4) =====================================
         Left-anchored, three named widths. Every left edge lands on the same
         start line; widths differ only rightward, so captions and prose stay
         aligned with wide/full figures by construction. */
      .post {
        display: grid;
        grid-template-columns:
          [full-start wide-start text-start] minmax(0, var(--measure))
          [text-end] minmax(0, calc(var(--measure-wide) - var(--measure)))
          [wide-end] minmax(0, 1fr)
          [full-end];
        max-width: var(--content-max);
        margin: 0 auto;
        padding-top: 22vh;
        padding-bottom: var(--space-section);
      }

      /* Everything defaults to the text column; media opts out via
         data-width. The renderer wrapper joins the grid via display:contents
         (astro-island already is). */
      .post > :global(*),
      .post :global(.portable-text-content > *) {
        grid-column: text;
      }

      .post :global(.portable-text-content) {
        display: contents;
      }

      .post :global([data-width="text"]) {
        grid-column: text;
      }

      .post :global([data-width="wide"]) {
        grid-column: wide;
      }

      .post :global([data-width="full"]) {
        grid-column: full;
      }

      /* == 1 · Header block =============================================== */
      .post-header {
        border-bottom: 0.5px solid rgba(var(--color-ink-rgb), 0.35);
        padding-bottom: 1.5rem;
      }

      .eyebrow {
        margin: 0 0 1.25rem;
        padding: 0;
        font-family: var(--font-mono);
        font-size: var(--type-meta);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
      }

      .title {
        margin: 0;
        /* ~20ch narrower than the body measure so long titles break well. */
        max-width: 45ch;
        font-family: var(--font-sans);
        font-weight: var(--weight-heading);
        font-size: var(--type-title);
        letter-spacing: -0.01em;
        line-height: 1.15;
        text-wrap: balance;
        color: var(--color-ink);
      }

      .deck {
        margin: 1.25rem 0 0;
        padding: 0;
        max-width: var(--measure);
        font-family: var(--font-sans);
        font-size: calc(var(--type-body) * 1.15);
        line-height: 1.5;
        color: var(--text-secondary);
      }

      /* Labeled metadata: LABEL value pairs, mono, tabular. */
      .meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 2.5rem;
        margin: 1.75rem 0 0;
        font-family: var(--font-mono);
        font-size: var(--type-meta);
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum";
      }

      .meta-pair {
        display: flex;
        gap: 0.75ch;
        align-items: baseline;
      }

      .meta-pair dt {
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
      }

      .meta-pair dd {
        margin: 0;
        color: var(--color-ink);
      }

      /* == 2 · Hero figure ================================================ */
      .post-hero {
        margin: 3rem 0 0;
      }

      .post-hero img {
        display: block;
        width: 100%;
        height: auto;
        /* One ratio site-wide; sources are also server-cropped to match. */
        aspect-ratio: 4 / 3;
        object-fit: cover;
      }

      .post-hero figcaption {
        /* Anchored to the text column's left edge (shared start line). */
        max-width: var(--measure);
        margin-top: 0.75rem;
        font-family: var(--font-mono);
        font-size: var(--type-meta);
        line-height: 1.5;
        color: var(--text-muted);
        text-align: left;
      }

      /* == 4 · Footer ===================================================== */
      .post-footer {
        margin-top: var(--space-section);
        border-top: 0.5px solid rgba(var(--color-ink-rgb), 0.35);
        padding-top: 1.5rem;
      }

      .mono-label {
        font-family: var(--font-mono);
        font-size: var(--type-meta);
        letter-spacing: 0.02em;
        color: var(--color-ink);
        opacity: 0.55;
        margin: 0;
        padding: 0;
      }

      .tag-row {
        margin: 0 0 1.5rem;
        padding: 0;
        font-family: var(--font-mono);
        font-size: var(--type-meta);
        color: var(--text-muted);
      }

      .sequence {
        display: flex;
        justify-content: space-between;
        gap: 2rem;
      }

      .seq-link {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        text-decoration: none;
        color: var(--color-ink);
      }

      .seq-next {
        margin-left: auto;
        text-align: right;
      }

      .seq-title {
        font-family: var(--font-sans);
        font-weight: var(--weight-heading);
        font-size: var(--type-body);
        transition: color 0.2s ease;
      }

      .seq-link:hover .seq-title,
      .seq-link:focus-visible .seq-title {
        color: var(--color-accent);
      }

      .seq-link:focus-visible,
      .back-link:focus-visible {
        outline: 1px solid var(--color-accent);
        outline-offset: 4px;
      }

      .back-link {
        display: inline-block;
        margin-top: 2.5rem;
        text-decoration: none;
        transition:
          color 0.2s ease,
          opacity 0.2s ease;
      }

      .back-link:hover {
        color: var(--color-accent);
        opacity: 1;
      }

      /* == Responsive ===================================================== */
      @media (max-width: 768px) {
        main {
          margin-left: 0;
          padding: 0 1.5rem;
        }

        .post {
          padding-top: 30%;
          /* All three widths collapse to one gutter-bounded column. */
          grid-template-columns:
            [full-start wide-start text-start] minmax(0, 1fr)
            [text-end wide-end full-end];
        }
      }
    </style>
  </body>
</html>
